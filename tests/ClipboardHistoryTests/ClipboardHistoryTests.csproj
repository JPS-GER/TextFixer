<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for the clipboard history store and settings. Links the sources; not part of the app build. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\TextFixer\Services\ClipboardHistory.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TextFixer\Services\AppSettings.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TextFixer\Services\Punctuation.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TextFixer\Services\Shortcuts.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TextFixer\Services\Dpapi.cs" Link="Services\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
