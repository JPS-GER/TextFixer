<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for the fact-check stream reader and parser. Links the sources; not part of the app build. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\TextFixer\Services\ChatGptResponsesClient.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TextFixer\Services\FactCheckParser.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TextFixer\Services\ChatGptHttp.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TextFixer\Services\ChatGptProtocol.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TextFixer\Services\ChatGptServiceException.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TextFixer\Contracts\ReviewContracts.cs" Link="Contracts\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
