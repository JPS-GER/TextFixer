{
  "manifest_version": 3,
  "name": "TextFixer Chrome Bridge",
  "version": "0.2.4",
  "description": "Review selected text in the TextFixer desktop app and apply targeted corrections without clipboard replacement.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TextFixer: select text, then right-click to review",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "key": ""
}
